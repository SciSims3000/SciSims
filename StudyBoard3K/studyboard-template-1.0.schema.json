{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scisims3000.github.io/studyboard3000/schemas/template-1.0.schema.json",
  "title": "StudyBoard3000 Template",
  "type": "object",
  "required": [
    "schemaVersion",
    "template",
    "navigation",
    "sections"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "navigation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "sectionId",
          "order"
        ]
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "title",
          "nodes"
        ]
      }
    },
    "template": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}