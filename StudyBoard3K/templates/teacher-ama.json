      "nodes": [
        {
          "id": "ama-instructions",
          "nodeType": "instructions-block",
          "title": "Instructions",
          "subtitle": "",
          "order": 0,
          "parentId": null,
          "outcomeCodes": [],
          "content": "<h2>Teacher Ask Me Anything</h2>\n<p>Use this board to collect and discuss questions during the session.</p>\n<ul>\n  <li>Choose the most relevant topic tab.</li>\n  <li>Select <strong>Question</strong> from the contribution type menu.</li>\n  <li>Add your name or use <strong>Anonymous</strong> if preferred.</li>\n  <li>Select <strong>Helpful</strong> to support a question you also want answered.</li>\n  <li>Use <strong>Reply</strong> to add an answer or continue the discussion.</li>\n</ul>\n<p><strong>Facilitator:</strong> promote strong answers to Teacher Highlights and export the instance JSON at the end of the session.</p>\n<p><strong>Current limitation:</strong> this static version stores contributions in the browser being used. It is suitable for one shared device or a projected, facilitator-operated board. Multi-device live synchronisation requires a backend.</p>",
          "collapsedByDefault": false,
          "tags": [],
          "metadata": {}
        }
      ]
    },
